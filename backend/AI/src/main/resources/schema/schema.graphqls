# ─────────────────────────────────────────────────────────────────────────────
# Think of Query as your GET endpoints, Mutation as POST/PUT/DELETE
# The "!" means non-null — GraphQL enforces this before your Java runs
# ─────────────────────────────────────────────────────────────────────────────

type Query {
    # Protected — requires valid JWT in Authorization header
    me: UserResponse!
}

type Mutation {
    # Public — no token needed
    register(input: RegisterInput!): AuthPayload!
    login(input: LoginInput!): AuthPayload!
    refresh(refreshToken: String!): AuthPayload!

    # Protected — requires valid JWT
    logout: Boolean!
}

# ── What the server returns ──────────────────────────────────────────────────

type AuthPayload {
    accessToken: String!
    refreshToken: String!
    user: UserResponse!
}

type UserResponse {
    id: String!
    email: String!
    name: String!
}

# ── What the client sends in ─────────────────────────────────────────────────
# "input" keyword = write-only type, can never be a return type

input RegisterInput {
    email: String!
    password: String!
    name: String!
}

input LoginInput {
    email: String!
    password: String!
}